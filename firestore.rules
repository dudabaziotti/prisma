rules_version = '2';

// Regras de segurança do Prisma (RNF05 - LGPD).
// - Só usuários autenticados leem perfis e publicações.
// - Cada usuário só altera ou exclui o próprio perfil.
// - Só o autor edita ou exclui a própria publicação (regra de negócio do DRE).
// - Só o autor edita o próprio comentário; o autor do comentário ou da publicação pode excluí-lo.
// - Só quem criou a sala de foco edita, exclui e controla o cronômetro; cada um entra e sai por si.
// - Qualquer usuário adiciona disciplinas ao catálogo; só quem adicionou edita ou exclui.
// - Cada usuário curte uma publicação uma vez só e só remove a própria curtida (o autor da publicação também pode).
// - Cada um segue em nome próprio; quem segue deixa de seguir e quem é seguido pode remover o seguidor.
// - Sala "só para seguidores" (RF17): só entra quem segue o dono da sala.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.bio is string && data.bio.size() <= 300
        && data.interests is list && data.interests.size() <= 10
        && data.avatar is string;
    }

    function validPost(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.subject is string && data.subject.size() <= 60
        && data.hashtags is list && data.hashtags.size() <= 20;
    }

    function validComment(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 1000
        && (data.parentId == null || data.parentId is string);
    }

    function follows(followerId, followedId) {
      return exists(/databases/$(database)/documents/follows/$(followerId + '_' + followedId));
    }

    // Sala pública, dono da sala ou seguidor do dono (RF17). Salas antigas sem "access" são públicas.
    function canJoin(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return room.get('access', 'public') == 'public'
        || room.ownerId == request.auth.uid
        || follows(request.auth.uid, room.ownerId);
    }

    function postAuthor(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.authorId;
    }

    function validRoom(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.subject is string && data.subject.size() <= 60
        && data.get('access', 'public') in ['public', 'followers']
        && data.timer is map
        && data.timer.status in ['idle', 'running', 'paused']
        && data.timer.elapsedMs is number && data.timer.elapsedMs >= 0;
    }

    function roomOwner(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId;
    }

    function validSubject(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 200;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validPost(request.resource.data);
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.authorId == resource.data.authorId
        && validPost(request.resource.data);
      allow delete: if isOwner(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validComment(request.resource.data)
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if isOwner(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.parentId == resource.data.parentId
          && validComment(request.resource.data);
        allow delete: if isOwner(resource.data.authorId) || isOwner(postAuthor(postId));
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.postAuthorId == postAuthor(postId);
        allow update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.postAuthorId == resource.data.postAuthorId;
        allow delete: if isOwner(uid) || isOwner(postAuthor(postId));
      }
    }

    // Consultas em todas as curtidas (exclusão de conta, troca de nome e ranking).
    match /{path=**}/likes/{uid} {
      allow read: if signedIn();
    }

    // Consultas em todos os comentários (exclusão de conta e troca de nome no perfil).
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validRoom(request.resource.data);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && validRoom(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);

      match /participants/{uid} {
        allow read: if signedIn();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && canJoin(roomId);
        allow delete: if isOwner(uid) || isOwner(roomOwner(roomId));
      }
    }

    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validSubject(request.resource.data);
      allow update: if isOwner(resource.data.createdBy)
        && request.resource.data.createdBy == resource.data.createdBy
        && validSubject(request.resource.data);
      allow delete: if isOwner(resource.data.createdBy);
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followedId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followedId
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followedId));
      // Troca de nome/avatar no perfil: cada lado atualiza o próprio nome, sem mudar o vínculo.
      allow update: if (isOwner(resource.data.followerId) || isOwner(resource.data.followedId))
        && request.resource.data.followerId == resource.data.followerId
        && request.resource.data.followedId == resource.data.followedId;
      allow delete: if isOwner(resource.data.followerId) || isOwner(resource.data.followedId);
    }

    // Consultas em todas as participações (exclusão de conta).
    match /{path=**}/participants/{uid} {
      allow read: if signedIn();
    }
  }
}